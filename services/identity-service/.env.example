# identity-service (S1) — copy to .env. Development values only; never commit real secrets.
# Spring profile: dev prints the verification code to the log and relaxes COOKIE_SECURE/JWT_KEK requirements.
SPRING_PROFILES_ACTIVE=dev
PORT=7001

# PostgreSQL (identity_db; Flyway migrates on start)
DATABASE_URL=jdbc:postgresql://localhost:5432/identity_db
DATABASE_USER=identity
DATABASE_PASSWORD=change-me
DB_POOL_SIZE=10

# RabbitMQ (topology comes from bandadau-infra definitions.json; set RABBIT_DECLARE_TOPOLOGY=true only for standalone dev)
RABBITMQ_URL=amqp://bandada:bandada@localhost:5672
RABBIT_DECLARE_TOPOLOGY=false
OUTBOX_RELAY_INTERVAL=PT1S

# JWT (RS256). A key pair is generated on first start and stored encrypted in signing_keys (needs JWT_KEK).
# JWT_PRIVATE_KEY_PATH optionally imports an existing PKCS#8 PEM as the first key.
JWT_ISSUER=http://api.bandada.localhost
JWT_KEK=dev-only-kek-change-me-0123456789abcdef
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
JWT_KEY_ID=
JWT_ROTATION_INTERVAL=P90D
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P30D
ADMIN_REFRESH_TOKEN_TTL=PT12H
HANDOFF_CODE_TTL=PT60S
VERIFICATION_CODE_TTL=PT15M
SERVICE_TOKEN_TTL=PT5M

# Public URLs used to build the handoff redirectUrl (never taken from the client)
APP_BASE_URL=http://app.bandada.localhost
ADMIN_BASE_URL=http://admin.bandada.localhost

# Mail (Mailpit in dev). MAIL_LOG_CODE also writes the code to the log (dev only).
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@bandadau.com
MAIL_LOG_CODE=true

# Service clients for /internal (id:secret[:scope|scope], comma separated). Development secrets only.
SERVICE_CLIENTS=bandada-seed:dev-secret-seed:users:read|users:write|universities:write,admin-gateway:dev-admin-gateway-secret,insights-service:dev-insights-secret,events-service:dev-events-secret,n8n:dev-n8n-secret

# Web hardening
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4201,http://localhost:8081,http://*.bandada.localhost
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=60
HANDOFF_RATE_LIMIT_PER_MINUTE=10
RESEND_MIN_INTERVAL=PT60S
RESEND_PER_HOUR=5
REGISTER_HIDE_EXISTING_ACCOUNTS=false

DEFAULT_LOCALE=es

# OpenTelemetry (off by default; the exporter is not bundled in phase 1)
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=identity-service
