# events-service (S4) — copy to .env. Development values only; never commit real secrets.
SPRING_PROFILES_ACTIVE=dev
PORT=7004

# PostgreSQL (events_db; Flyway migrates on start)
DATABASE_URL=jdbc:postgresql://localhost:5432/events_db
DATABASE_USER=events
DATABASE_PASSWORD=change-me
DB_POOL_SIZE=10

# RabbitMQ (topology comes from bandadau-infra definitions.json; the service only verifies/consumes events-service.saga-replies)
RABBITMQ_URL=amqp://bandada:bandada@localhost:5672
RABBIT_DECLARE_TOPOLOGY=false
OUTBOX_RELAY_INTERVAL=PT1S

# JWT validation (JWKS of identity-service, cached)
JWKS_URL=http://localhost:7001/.well-known/jwks.json
JWT_ISSUER=http://api.bandada.localhost

# Service client used to call media-service (token from identity-service POST /api/v1/auth/service-token)
IDENTITY_SERVICE_URL=http://localhost:7001
SERVICE_CLIENT_ID=events-service
SERVICE_CLIENT_SECRET=dev-events-secret

# Cover validation against media-service (getMediaInternal / getMediaUrls). off = no calls (dev without media-service)
COVER_CHECK=off
MEDIA_SERVICE_URL=http://localhost:7003
MEDIA_TIMEOUT=PT2S

# SAGA timing (decisiones-clave D2/D15): 30 s per step, resends at 5/10/20 s, compensations retried without limit
SAGA_STEP_TIMEOUT=PT30S
SAGA_RESEND_OFFSETS=PT5S,PT10S,PT20S
SAGA_COMPENSATION_BACKOFF=PT5S
SAGA_COMPENSATION_BACKOFF_CAP=PT60S
SAGA_COMPENSATION_ALERT_AFTER=PT2M
SAGA_SCHEDULER_INTERVAL=PT5S

# Events
EVENT_DEFAULT_DURATION=PT2H
REGISTRATION_CANCELLATION_CUTOFF=PT24H
DEFAULT_LOCALE=es

# OpenTelemetry (off by default; the exporter is not bundled in phase 1)
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=events-service
