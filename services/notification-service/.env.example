# notification-service — copy to .env for local use. No real secrets here.
APP_NAME=notification-service
APP_ENV=local
APP_DEBUG=false
APP_KEY=
APP_PORT=7007
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
LOG_CHANNEL=stdout
LOG_LEVEL=info

# DynamoDB (tables created by bandadau-infra: bandada-notifications with GSI1, bandada-idempotency)
NOTIFICATIONS_TABLE=bandada-notifications
IDEMPOTENCY_TABLE=bandada-idempotency
DYNAMODB_ENDPOINT=http://dynamodb-local:8000
DYNAMODB_AUTO_CREATE_TABLES=false
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# RabbitMQ (topology owned by bandadau-infra; RABBITMQ_DECLARE_TOPOLOGY=true only in dev/tests)
RABBITMQ_URL=amqp://bandada:bandada@rabbitmq:5672
RABBITMQ_PREFETCH=10
RABBITMQ_DECLARE_TOPOLOGY=false

# Auth (RS256 via JWKS from identity-service)
JWKS_URL=http://identity-service:7001/.well-known/jwks.json
JWT_ISSUER=http://api.bandada.localhost
JWT_USER_AUDIENCES=bandada-app,bandada-admin
JWT_INTERNAL_AUDIENCE=bandada-internal
JWKS_CACHE_TTL=300

# Notifications
NOTIFICATION_TTL_DAYS=90
APP_DEEP_LINK_BASE=http://app.bandada.localhost
EMAIL_ENABLED=true
PUSH_ENABLED=false
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=

# Email (Laravel Mailer over SMTP -> Mailpit in dev)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=no-reply@bandada.localhost
MAIL_FROM_NAME="Bandada U"

# CORS (comma separated; wildcards allowed). Empty = no CORS headers (when Traefik handles CORS).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4201,http://localhost:8081,http://*.bandada.localhost

# Observability (traceparent is propagated; no OTLP exporter in phase 1)
OTEL_SERVICE_NAME=notification-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
