{
  "name": "insights-service",
  "version": "0.1.0",
  "private": true,
  "description": "Bandada U insights-service (S8): MCP server, report and monitoring agents, generative reports",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.7",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/frameworks-drivers/main.js",
    "test": "jest --config jest.config.cjs",
    "test:int": "jest --config jest.int.config.cjs --runInBand",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "mcp:sync": "node scripts/sync-mcp-contract.cjs",
    "mcp:inspect": "npx @modelcontextprotocol/inspector"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@aws-sdk/client-dynamodb": "^3.1151.0",
    "@aws-sdk/client-polly": "^3.1151.0",
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/lib-dynamodb": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@bandada/auth-ts": "file:../../../bandadau-shared/packages/auth-ts",
    "@bandada/contracts-ts": "file:../../../bandadau-shared/packages/contracts-ts",
    "@bandada/i18n": "file:../../../bandadau-shared/packages/i18n",
    "@bandada/idempotency-ts": "file:../../../bandadau-shared/packages/idempotency-ts",
    "@bandada/messaging-ts": "file:../../../bandadau-shared/packages/messaging-ts",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jose": "^6.2.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bandada/eslint-config": "file:../../../bandadau-shared/packages/eslint-config",
    "@bandada/tsconfig": "file:../../../bandadau-shared/packages/tsconfig",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.0",
    "amqplib": "^2.2.0",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9.39.5",
