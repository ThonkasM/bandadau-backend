# insights-service — desarrollo local (valores ficticios; ver bandadau-infra/.env.example)
PORT=7008
NODE_ENV=development
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
INSIGHTS_TABLE=bandada-insights
IDEMPOTENCY_TABLE=bandada-idempotency
# S3/MinIO (bucket de reportes). S3_ENDPOINT = interno, S3_PUBLIC_ENDPOINT = el que ve el navegador (URL prefirmada)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET_AUDIO=bandada-reports
S3_ACCESS_KEY_ID=insights-svc
S3_SECRET_ACCESS_KEY=insights_svc_dev_pw
RABBITMQ_URL=amqp://bandada:bandada@localhost:5672
RABBITMQ_MANAGEMENT_URL=http://localhost:15672
RABBITMQ_MANAGEMENT_USER=monitor
RABBITMQ_MANAGEMENT_PASSWORD=monitor_dev
JWKS_URL=http://localhost:7001/.well-known/jwks.json
JWT_ISSUER=http://api.bandada.localhost
IDENTITY_URL=http://localhost:7001
SERVICE_CLIENT_ID=insights-service
SERVICE_CLIENT_SECRET=dev-secret-insights
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4201,http://localhost:8081
# Servicios consultados por las herramientas MCP (/internal/v1 y /health/ready)
SOCIAL_SERVICE_URL=http://localhost:7002
MEDIA_SERVICE_URL=http://localhost:7003
EVENTS_SERVICE_URL=http://localhost:7004
WALLET_SERVICE_URL=http://localhost:7005
TICKETING_SERVICE_URL=http://localhost:7006
NOTIFICATION_SERVICE_URL=http://localhost:7007
ADMIN_GATEWAY_URL=http://localhost:7010
# Prometheus (perfil observability) para la herramienta query_metrics; vacío = herramienta responde UPSTREAM_UNAVAILABLE
PROMETHEUS_URL=

# ---- MCP ---------------------------------------------------------------------------------------
# Cliente MCP loopback de los agentes (por defecto http://127.0.0.1:$PORT/mcp)
PUBLIC_API_URL=http://api.bandada.localhost
MCP_INTERNAL_URL=http://127.0.0.1:7008/mcp
MCP_ALLOWED_ORIGINS=
# Clientes de servicio con acceso a /mcp (identity solo emite internal:read/write: el scope mcp:tools es opcional)
MCP_SERVICE_CLIENTS=insights-service
MCP_REQUIRE_SCOPE=false
MCP_RATE_LIMIT_PER_MIN=30
MCP_REPORTS_PER_HOUR=10

# ---- LLM (LlmPort) -----------------------------------------------------------------------------
# stub (determinista, sin red: por defecto) | claude | ollama
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_MODEL_CHEAP=claude-haiku-5-5
# precios USD por millón de tokens del modelo "smart" (para costUsdMicros del AgentRun)
LLM_PRICE_IN_PER_M=2
LLM_PRICE_OUT_PER_M=10
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---- TTS (TtsPort) -----------------------------------------------------------------------------
# none (reporte sin audio: por defecto) | piper | polly
TTS_PROVIDER=none
PIPER_URL=http://localhost:5002
TTS_VOICE_ES=es_MX-claude-high
TTS_VOICE_EN=en_US-lessac-medium
POLLY_VOICE_ES=Mia
POLLY_VOICE_EN=Joanna

# ---- Agentes -----------------------------------------------------------------------------------
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=20000
MONITORING_ENABLED=true
MONITORING_EXPLAIN=true
ANOMALY_METRICS=registrationsConfirmed,registrationsFailed,posts,creditsSpent,sagaCompensations
ANOMALY_DAYS=30
ANOMALY_SENSITIVITY=0.8
MONITORING_DLQ_CRITICAL=50
MONITORING_QUEUE_BACKLOG=1000
MONITORING_SAGA_FAILED_CRITICAL=5
MONITORING_SAGA_COMPENSATED_WARNING=10
MONITORING_MODERATION_PENDING=20
ANALYTICS_CONSUMER_ENABLED=true
OUTBOX_RELAY_INTERVAL_MS=500
DEFAULT_LOCALE=es
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=insights-service
