            "additionalProperties": false
          },
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "topUpCredits": {
                  "type": "integer"
                },
                "debitCredits": {
                  "type": "integer"
                },
                "refundCredits": {
                  "type": "integer"
                }
              },
              "required": [
                "date",
                "topUpCredits",
                "debitCredits",
                "refundCredits"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "from",
          "to",
          "groupBy",
          "totals",
          "series"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Estadísticas de créditos",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "x-source": "wallet-service — `GET /internal/v1/stats/credits?from&to&groupBy` (`getCreditStats`)",
      "x-permissions": "Rol `ADMIN` o token de servicio.",
      "x-internal-only": false
    },
