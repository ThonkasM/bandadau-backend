{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bandadau.com/contracts/mcp/tools.schema.json",
  "title": "Bandada U — herramientas MCP (insights-service)",
  "description": "Definiciones de herramientas MCP (name, title, description, inputSchema, outputSchema, annotations) para generar código. Fuente de verdad junto con tools.md. Versión 1.1.0.",
  "version": "1.1.0",
  "server": {
    "name": "bandada-insights",
    "transport": "streamable-http",
    "path": "/mcp"
  },
  "tools": [
    {
      "name": "get_platform_kpis",
      "title": "KPIs de la plataforma",
      "description": "Devuelve los indicadores agregados de Bandada U en un rango de fechas: usuarios activos y nuevos, posts, comentarios, reacciones, inscripciones (confirmadas/fallidas/canceladas), créditos recargados y gastados, contenido marcado y alertas abiertas, más una serie diaria. Úsala como primer paso para cualquier pregunta general sobre actividad o crecimiento. Los datos son agregados, sin información personal.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date",
            "description": "Fecha inicial inclusiva (UTC), formato YYYY-MM-DD."
          },
          "to": {
            "type": "string",
            "format": "date",
            "description": "Fecha final inclusiva (UTC), formato YYYY-MM-DD. Máximo 366 días después de `from`."
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "activeUsers": {
            "type": "integer"
          },
          "newUsers": {
            "type": "integer"
          },
          "posts": {
            "type": "integer"
          },
          "comments": {
            "type": "integer"
          },
          "reactions": {
            "type": "integer"
          },
          "registrationsConfirmed": {
            "type": "integer"
          },
          "registrationsFailed": {
            "type": "integer"
          },
          "registrationsCancelled": {
            "type": "integer"
          },
          "creditsToppedUp": {
            "type": "integer"
          },
          "creditsSpent": {
            "type": "integer"
          },
          "flaggedContent": {
            "type": "integer"
          },
          "openAlerts": {
            "type": "integer"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "activeUsers": {
                  "type": "integer"
                },
                "posts": {
                  "type": "integer"
                },
                "registrationsConfirmed": {
                  "type": "integer"
                },
                "creditsSpent": {
                  "type": "integer"
                }
              },
              "required": [
                "date"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "from",
          "to",
          "activeUsers",
          "newUsers",
          "posts",
          "registrationsConfirmed",
          "creditsSpent",
          "series"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "KPIs de la plataforma",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "x-source": "insights-service (proyección de métricas `METRIC#<name>` en DynamoDB) — `GET /internal/v1/kpis`",
      "x-permissions": "Rol `ADMIN` o token de servicio.",
      "x-internal-only": false
    },
    {
      "name": "get_registration_stats",
      "title": "Estadísticas de inscripciones",
      "description": "Devuelve estadísticas de inscripciones a eventos en un rango, agrupadas por día, por evento o por estado (PENDING, CONFIRMED, FAILED, CANCELLATION_PENDING, CANCELLED). Úsala para preguntas sobre demanda de eventos, tasas de fallo de inscripción o comparación entre eventos.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date",
            "description": "Fecha inicial inclusiva (UTC), formato YYYY-MM-DD."
          },
          "to": {
            "type": "string",
            "format": "date",
            "description": "Fecha final inclusiva (UTC), formato YYYY-MM-DD. Máximo 366 días después de `from`."
          },
          "groupBy": {
            "type": "string",
            "enum": [
              "day",
              "event",
              "status"
            ],
            "default": "day",
            "description": "Dimensión de agrupación."
          },
          "eventId": {
            "type": "string",
            "format": "uuid",
            "description": "Opcional: limitar a un evento."
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "groupBy": {
            "type": "string",
            "enum": [
              "day",
              "event",
              "status"
            ]
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Fecha, eventId o estado según groupBy."
                },
                "label": {
                  "type": "string",
                  "description": "Título del evento cuando groupBy=event."
                },
                "confirmed": {
                  "type": "integer"
                },
                "failed": {
                  "type": "integer"
                },
                "cancelled": {
                  "type": "integer"
                },
                "pending": {
                  "type": "integer"
                }
              },
              "required": [
                "key",
                "confirmed",
                "failed",
                "cancelled"
              ],
              "additionalProperties": false
            }
          },
          "totals": {
            "type": "object",
            "properties": {
              "confirmed": {
                "type": "integer"
              },
              "failed": {
                "type": "integer"
              },
              "cancelled": {
                "type": "integer"
              },
              "pending": {
                "type": "integer"
              }
            },
            "required": [
              "confirmed",
              "failed",
              "cancelled",
              "pending"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "from",
          "to",
          "groupBy",
          "rows",
          "totals"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Estadísticas de inscripciones",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "x-source": "events-service — `GET /internal/v1/stats/registrations?from&to&groupBy` (`getRegistrationStats`)",
      "x-permissions": "Rol `ADMIN` o token de servicio.",
      "x-internal-only": false
    },
    {
      "name": "list_events",
      "title": "Listar eventos",
      "description": "Lista eventos y talleres de la plataforma en un rango de fechas de inicio, opcionalmente filtrados por estado (DRAFT, PUBLISHED, CANCELLED, FINISHED). Devuelve título, fecha, lugar, cupo, plazas ocupadas y precio en créditos. Úsala para contextualizar estadísticas de inscripciones o responder qué eventos hubo o habrá.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date-time",
            "description": "Inicio del rango (startsAt ≥ from)."
          },
          "to": {
            "type": "string",
            "format": "date-time",
            "description": "Fin del rango (startsAt ≤ to)."
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED",
              "CANCELLED",
              "FINISHED"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 50
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "eventId": {
                  "type": "string",
                  "format": "uuid"
                },
                "title": {
                  "type": "string"
                },
                "startsAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "venue": {
                  "type": "string"
                },
                "capacity": {
                  "type": "integer"
                },
                "seatsTaken": {
                  "type": "integer"
                },
                "priceCredits": {
                  "type": "integer"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "DRAFT",
                    "PUBLISHED",
                    "CANCELLED",
                    "FINISHED"
                  ]
                }
              },
              "required": [
                "eventId",
                "title",
                "startsAt",
                "venue",
                "capacity",
                "seatsTaken",
                "priceCredits",
                "status"
              ],
              "additionalProperties": false
            }
          },
          "truncated": {
            "type": "boolean",
            "description": "true si había más eventos que `limit`."
          }
        },
        "required": [
          "items",
          "truncated"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Listar eventos",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "x-source": "events-service — `GET /internal/v1/events?startsFrom&startsTo&status` (`listEventsInternal`, D15)",
      "x-permissions": "Rol `ADMIN` o token de servicio.",
      "x-internal-only": false
    },
    {
      "name": "get_credit_stats",
      "title": "Estadísticas de créditos",
      "description": "Devuelve totales y series de la economía de créditos en un rango: recargas, débitos por inscripciones y reembolsos (cantidad y créditos), saldo neto y créditos en circulación. Los créditos son enteros. Úsala para preguntas de ingresos, consumo o reembolsos.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date",
