    {
      "name": "raise_alert",
      "title": "Crear alerta",
      "description": "Crea una alerta operativa visible en vivo en el panel y notificada al equipo si es CRITICAL. Solo para el agente de monitoreo interno: úsala cuando una consulta muestre un problema real (servicio caído, SAGAs fallidas, mensajes en DLQ, backlog de moderación o anomalía). No crees alertas duplicadas: usa el mismo `dedupeKey` para el mismo problema.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "INFO",
              "WARNING",
              "CRITICAL"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "SERVICE_DOWN",
              "SAGA_FAILURES",
              "DLQ_BACKLOG",
              "MODERATION_BACKLOG",
              "METRIC_ANOMALY",
              "MODERATION_ESCALATION"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 1000,
            "description": "Mensaje en español, concreto y accionable."
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          },
          "dedupeKey": {
            "type": "string",
            "maxLength": 200,
            "description": "Clave de deduplicación (p. ej. `SAGA_FAILURES:ticketing-service`); una alerta OPEN con la misma clave no se duplica."
          }
        },
        "required": [
          "severity",
          "kind",
          "message",
          "dedupeKey"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "alertId": {
            "type": "string",
            "format": "uuid"
          },
          "created": {
            "type": "boolean",
            "description": "false si ya existía una alerta OPEN con el mismo dedupeKey."
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "ACKNOWLEDGED",
              "RESOLVED"
            ]
          }
        },
        "required": [
          "alertId",
          "created",
          "status"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Crear alerta",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "x-source": "insights-service — caso de uso interno `RaiseAlert` (DynamoDB `ALERT#<id>`); publica `bandada.insights.alert.raised.v1`",
      "x-permissions": "Solo token de servicio (`typ=service`, `sub=insights-service`). Oculta en `tools/list` para clientes con JWT de usuario.",
      "x-internal-only": true
    }
