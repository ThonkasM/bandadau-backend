              "topUpCount": {
                "type": "integer"
              },
              "topUpCredits": {
                "type": "integer"
              },
              "debitCount": {
                "type": "integer"
              },
              "debitCredits": {
                "type": "integer"
              },
              "refundCount": {
                "type": "integer"
              },
              "refundCredits": {
                "type": "integer"
