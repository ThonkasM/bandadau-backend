            "type": "string",
            "maxLength": 1000,
            "description": "Pregunta original que responde el reporte."
          },
          "markdown": {
            "type": "string",
            "maxLength": 20000
          },
          "dataset": {
            "type": "object",
            "properties": {
              "columns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "string",
                        "integer",
                        "number",
                        "date",
                        "datetime",
                        "boolean"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "type"
                  ],
                  "additionalProperties": false
                }
              },
              "rows": {
                "type": "array",
                "maxItems": 5000,
                "items": {
                  "type": "array"
                }
              }
            },
            "required": [
              "columns",
              "rows"
            ],
            "additionalProperties": false
          },
          "chart": {
            "type": "object",
            "description": "Especificación Vega-Lite v5 (sin `data.url`; usa el dataset).",
            "additionalProperties": true
          },
          "audioSummary": {
            "type": "string",
            "maxLength": 1400,
            "description": "Guion del audio (≤ 90 s, ~200 palabras)."
          },
          "locale": {
            "type": "string",
            "enum": [
              "es",
              "en"
            ],
            "description": "Idioma del reporte y del audio (D14). Por defecto, el del solicitante."
