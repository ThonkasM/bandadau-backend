    {
      "name": "query_metrics",
      "title": "Consultar métricas técnicas (PromQL acotado)",
      "description": "Ejecuta una consulta PromQL de solo lectura contra Prometheus (stack LGTM) y devuelve series agregadas. Solo admite las métricas de la allowlist (latencia HTTP, duración y compensaciones de SAGA, outbox, fallos de consumo, profundidad de DLQ, backlog de moderación, inferencia ML, logins fallidos y uso de agentes) y funciones de agregación; el resultado se limita a 50 series y 500 puntos. Úsala para confirmar con datos técnicos un problema antes de levantar una alerta (p. ej. p95 de latencia o tasa de compensación en los últimos 15 min). No devuelve datos personales.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500,
            "description": "Expresión PromQL. Todo selector de métrica debe estar en la allowlist; se rechazan selectores sin nombre de métrica, `{__name__=~...}` y subconsultas con rango > 24 h."
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "description": "Inicio de una consulta de rango (UTC). Si se omiten `start` y `end` se ejecuta una consulta instantánea."
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "description": "Fin de la consulta de rango (UTC). Máximo 7 días después de `start`."
          },
          "step": {
            "type": "string",
            "pattern": "^[0-9]+[smh]$",
            "default": "60s",
            "description": "Resolución de la consulta de rango (p. ej. `60s`, `5m`). Mínimo efectivo 15s."
          }
        },
        "required": [
          "query"
        ],
        "dependentRequired": {
          "start": [
            "end"
          ],
          "end": [
            "start"
          ]
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "resultType": {
            "type": "string",
            "enum": [
              "vector",
              "matrix",
              "scalar"
            ]
          },
          "series": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "properties": {
                "labels": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "points": {
                  "type": "array",
                  "maxItems": 500,
                  "items": {
                    "type": "object",
                    "properties": {
                      "t": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "v": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "t",
                      "v"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "labels",
                "points"
              ],
              "additionalProperties": false
            }
          },
          "truncated": {
            "type": "boolean",
            "description": "`true` si se recortaron series o puntos."
          },
          "executedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "resultType",
          "series",
          "truncated",
          "executedAt"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Consultar métricas técnicas (PromQL acotado)",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "x-source": "Prometheus del stack LGTM (`otel-lgtm`) — `GET /api/v1/query` y `/api/v1/query_range` desde insights-service; métricas de `bandadau-docs/docs/03-arquitectura/observabilidad.md` §6 (D15)",
      "x-permissions": "Solo token de servicio (MonitoringAgent) o rol `ADMIN`. No se lista para otros roles.",
      "x-internal-only": false,
      "x-metrics-allowlist": [
        "http_server_request_duration_seconds",
        "traefik_service_request_duration_seconds",
        "saga_duration_seconds",
        "saga_compensations_total",
        "saga_active",
        "idempotency_replays_total",
        "inbox_duplicates_total",
        "outbox_pending",
        "outbox_publish_lag_seconds",
        "messaging_consume_failures_total",
        "dlq_depth",
        "moderation_backlog",
        "ml_inference_duration_seconds",
        "ml_decisions_total",
        "auth_login_failures_total",
        "agent_runs_total",
        "agent_tokens_total"
      ]
    },
    {
      "name": "detect_anomalies",
      "title": "Detectar anomalías en métricas",
      "description": "Ejecuta el modelo Isolation Forest sobre una o más series de métricas diarias u horarias y devuelve los puntos anómalos con su puntaje. Métricas disponibles: activeUsers, posts, registrationsConfirmed, registrationsFailed, creditsSpent, flaggedContent, sagaCompensations. Úsala para explicar picos o caídas inusuales.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "array",
            "minItems": 1,
            "maxItems": 7,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "activeUsers",
                "posts",
                "registrationsConfirmed",
                "registrationsFailed",
                "creditsSpent",
                "flaggedContent",
                "sagaCompensations"
              ]
            }
          },
          "from": {
            "type": "string",
            "format": "date",
            "description": "Fecha inicial inclusiva (UTC), formato YYYY-MM-DD."
          },
          "to": {
            "type": "string",
            "format": "date",
            "description": "Fecha final inclusiva (UTC), formato YYYY-MM-DD. Máximo 366 días después de `from`."
          },
          "granularity": {
            "type": "string",
            "enum": [
              "hour",
              "day"
            ],
            "default": "day"
          },
          "sensitivity": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 0.99,
            "default": 0.8,
            "description": "Umbral del puntaje de anomalía (más alto = menos alertas)."
          }
        },
        "required": [
          "metrics",
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "modelVersion": {
            "type": "string"
          },
          "anomalies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "metric": {
                  "type": "string"
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "value": {
                  "type": "number"
                },
                "expected": {
                  "type": "number"
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "SPIKE",
                    "DROP"
                  ]
                }
              },
              "required": [
                "metric",
                "at",
                "value",
                "expected",
                "score",
                "direction"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "modelVersion",
          "anomalies"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Detectar anomalías en métricas",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "x-source": "insights-service — modelo `anomaly-detector` (Isolation Forest ONNX) sobre `METRIC#<name>`; sin llamada externa",
      "x-permissions": "Rol `ADMIN` o token de servicio.",
      "x-internal-only": false
    },
    {
      "name": "generate_report",
      "title": "Generar reporte",
      "description": "Crea un reporte generativo persistente (GeneratedReport) con título, texto en Markdown, dataset tabular y gráfico Vega-Lite opcional, y encola la narración en audio (≤ 90 s). Llámala UNA sola vez, al final, cuando ya reuniste los datos con las herramientas de consulta. El reporte se escribe en el idioma indicado en `locale`.",
