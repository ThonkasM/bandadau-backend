            "type": "string",
            "enum": [
              "PENDING",
              "NONE"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Enlace al reporte en el panel."
          }
        },
        "required": [
          "reportId",
          "status",
          "audioStatus",
          "url"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Generar reporte",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
