# media-service (S3) — copy to .env for local runs outside Docker (`pnpm dev`). Compose injects its own values.
NODE_ENV=development
PORT=7003
LOG_LEVEL=info
TZ=America/La_Paz

MONGODB_URI=mongodb://media:media_dev@localhost:27017/media?replicaSet=rs0&authSource=media&directConnection=true
RABBITMQ_URL=amqp://bandada:bandada@localhost:5672

JWKS_URL=http://localhost:7001/.well-known/jwks.json
JWT_ISSUER=http://api.bandada.localhost

IDEMPOTENCY_TABLE=bandada-idempotency
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# S3 / MinIO. Presigned URLs are signed with S3_PUBLIC_ENDPOINT (reachable by browsers/phones); data-plane calls use S3_ENDPOINT.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET_MEDIA=bandada-media
S3_BUCKET_MODELS=bandada-models
S3_ACCESS_KEY_ID=media-svc
S3_SECRET_ACCESS_KEY=media_svc_dev_pw
S3_FORCE_PATH_STYLE=true

# Uploads (contract: expiresIn 900) and limits (RF-06 / ADR-0016)
UPLOAD_URL_TTL_SECONDS=900
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=52428800

# Moderation: allow-all (APPROVED on completeUpload) | manual (FLAGGED -> moderators' queue) | onnx (NSFW classifier, phase 2; needs the model in MinIO)
MODERATION_MODE=allow-all

DEFAULT_LOCALE=es
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4201,http://localhost:8081
RATE_LIMIT_PER_MINUTE=300
OUTBOX_POLL_MS=500
STALE_PROCESSING_MS=30000
MESSAGING_ENABLED=true

# Phase 2 (MODERATION_MODE=onnx): model models/<MODEL_NAME>/<MODEL_VERSION>/ in bucket MODEL_BUCKET (default S3_BUCKET_MODELS)
S3_BUCKET_MODELS=bandada-models
# MODEL_BUCKET=bandada-models
MODEL_NAME=nsfw-classifier
# MODEL_VERSION falls back to MODEL_NSFW_VERSION
MODEL_NSFW_VERSION=1.0.0
MODEL_VARIANT=fp32
MODEL_CACHE_DIR=/tmp/models-cache
MODEL_RETRY_MS=60000
ORT_THREADS=2
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_MAX_SECONDS=60
# Thresholds: when unset the model's metadata.json values are used (0.85 / 0.5)
MODEL_VIOLENCE_VERSION=1.0.0
MODEL_CLIP_VERSION=1.0.0
# MODERATION_BLOCK_THRESHOLD=0.85
# MODERATION_REVIEW_THRESHOLD=0.5
VIDEO_FRAME_INTERVAL_SECONDS=2
VIDEO_MAX_FRAMES=30
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=media-service
