{
  "name": "social-service",
  "version": "0.1.0",
  "private": true,
  "description": "Bandada U social-service: profiles, posts, feed, comments, reactions, follows, groups and reports (Clean Architecture, NestJS 11, MongoDB)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.7",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "pnpm arch && tsc -p tsconfig.build.json",
    "start": "node dist/frameworks-drivers/main.js",
    "dev": "tsc -p tsconfig.build.json && node --watch dist/frameworks-drivers/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "test": "jest --selectProjects unit",
    "test:int": "jest --selectProjects integration --runInBand",
    "test:all": "jest --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1151.0",
    "@aws-sdk/lib-dynamodb": "^3.1151.0",
    "@bandada/auth-ts": "file:../../../bandadau-shared/packages/auth-ts",
    "@bandada/contracts-ts": "file:../../../bandadau-shared/packages/contracts-ts",
    "@bandada/i18n": "file:../../../bandadau-shared/packages/i18n",
    "@bandada/idempotency-ts": "file:../../../bandadau-shared/packages/idempotency-ts",
    "@bandada/messaging-ts": "file:../../../bandadau-shared/packages/messaging-ts",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "helmet": "^8.3.0",
    "mongodb": "^7.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bandada/eslint-config": "file:../../../bandadau-shared/packages/eslint-config",
    "@bandada/tsconfig": "file:../../../bandadau-shared/packages/tsconfig",
    "@nestjs/testing": "11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9.3"
  }
}
