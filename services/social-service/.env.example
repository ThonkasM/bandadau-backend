# social-service (S2) — copy to .env for local runs outside Docker (`pnpm dev`). Compose injects its own values.
NODE_ENV=development
PORT=7002
LOG_LEVEL=info
TZ=America/La_Paz

# MongoDB replica set rs0 (transactions + outbox). Host-side runs need `directConnection=true`
# because the replica set advertises `mongo:27017`.
MONGODB_URI=mongodb://social:social_dev@localhost:27017/social?replicaSet=rs0&authSource=social&directConnection=true
RABBITMQ_URL=amqp://bandada:bandada@localhost:5672

# Auth: identity JWKS (RS256) and service-to-service client credentials (dev values, not secrets)
JWKS_URL=http://localhost:7001/.well-known/jwks.json
JWT_ISSUER=http://api.bandada.localhost
IDENTITY_URL=http://localhost:7001
SERVICE_CLIENT_ID=social-service
SERVICE_CLIENT_SECRET=dev-secret-social

# media-service (internal REST, timeout + circuit breaker)
MEDIA_SERVICE_URL=http://localhost:7003
MEDIA_HTTP_TIMEOUT_MS=1500

# Idempotency-Key store (DynamoDB Local in dev)
IDEMPOTENCY_TABLE=bandada-idempotency
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

DEFAULT_LOCALE=es
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4201,http://localhost:8081
REPORT_HIDE_THRESHOLD=3
RATE_LIMIT_PER_MINUTE=300
OUTBOX_POLL_MS=500
PENDING_MEDIA_SWEEP_MS=60000
MESSAGING_ENABLED=true
INTERNAL_SCOPES_ENFORCED=true

# Accepted for compatibility (phase 2 feed ranker); unused in phase 1
FEED_MODEL_PATH=./models/feed-ranker/coefficients.json
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=social-service
