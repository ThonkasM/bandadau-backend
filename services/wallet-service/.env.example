# wallet-service — copy to .env for local use. No real secrets here.
APP_NAME=wallet-service
APP_ENV=local
APP_DEBUG=false
APP_KEY=
APP_PORT=7005
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
LOG_LEVEL=info

# PostgreSQL (wallet_db)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=wallet_db
DB_USERNAME=wallet
DB_PASSWORD=change-me
DB_SSLMODE=prefer

# RabbitMQ (topology owned by bandadau-infra; set RABBITMQ_DECLARE_TOPOLOGY=true only in dev/tests)
RABBITMQ_URL=amqp://bandada:bandada@rabbitmq:5672
RABBITMQ_PREFETCH=20
RABBITMQ_DECLARE_TOPOLOGY=false
OUTBOX_POLL_INTERVAL_MS=500

# Auth (RS256 via JWKS from identity-service)
JWKS_URL=http://identity-service:7001/.well-known/jwks.json
JWT_ISSUER=http://api.bandada.localhost
JWT_USER_AUDIENCES=bandada-app,bandada-admin
JWT_INTERNAL_AUDIENCE=bandada-internal
JWKS_CACHE_TTL=300

# Payments (simulated gateway)
PAYMENT_SIMULATOR_ENABLED=true
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENT_CHECKOUT_BASE_URL=http://app.bandada.localhost/wallet/checkout
TOPUP_PACKAGES=CREDITS_20,CREDITS_50,CREDITS_100
TOPUP_TTL_MINUTES=30

# Idempotency-Key store (DynamoDB; leave endpoint empty to use AWS)
IDEMPOTENCY_TABLE=bandada-idempotency
DYNAMODB_ENDPOINT=http://dynamodb:8000
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# CORS (comma separated; wildcards allowed, e.g. http://*.bandada.localhost). Empty = no CORS headers.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4201,http://localhost:8081,http://*.bandada.localhost

# Demo chaos flag (must be 0 in production): delays every SAGA command by N ms
CHAOS_WALLET_DELAY_MS=0

# Observability (traceparent is propagated; no OTLP exporter in phase 1)
OTEL_SERVICE_NAME=wallet-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
