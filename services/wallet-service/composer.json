{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bandada/wallet-service",
    "type": "project",
    "description": "Bandada U - wallet-service (credits wallet, top-ups, SAGA debit/refund participant).",
    "license": "proprietary",
    "version": "0.1.0",
    "require": {
        "php": "^8.4",
        "aws/aws-sdk-php": "^3.401",
        "firebase/php-jwt": "^7.2",
        "laravel/framework": "^12.0",
        "php-amqplib/php-amqplib": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Bandada\\Wallet\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "scripts": {
        "test": "pest",
        "test:unit": "pest --testsuite=Unit",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=512M",
        "arch": "deptrac analyse --fail-on-uncovered",
        "qa": [
            "@lint",
            "@analyse",
            "@arch",
            "@test"
        ],
        "pre-autoload-dump": "Aws\\Script\\Composer\\Composer::removeUnusedServices"
    },
    "extra": {
        "aws/aws-sdk-php": [
            "DynamoDb",
            "Sts"
        ]
    }
}
