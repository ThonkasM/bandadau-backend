# ticketing-service — desarrollo local (valores ficticios; ver bandadau-infra/.env.example)
PORT=7006
NODE_ENV=development
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
TICKETING_TABLE=bandada-ticketing
IDEMPOTENCY_TABLE=bandada-idempotency
RABBITMQ_URL=amqp://bandada:bandada@localhost:5672
JWKS_URL=http://localhost:7001/.well-known/jwks.json
JWT_ISSUER=http://api.bandada.localhost
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4201,http://localhost:8081
# Par ES256 (PKCS#8 PEM). En desarrollo: bandadau-infra/secrets/qr-es256.pem (make keys)
QR_SIGNING_KEY_PATH=../../../bandadau-infra/secrets/qr-es256.pem
QR_SIGNING_KID=tk-2026-10
# Opcional: JWKS (solo claves públicas) de claves rotadas que aún se aceptan al validar
QR_PREVIOUS_JWKS_PATH=
# Demo del rollback de la SAGA: issue-ticket responde ticket-issue-failed (se lee al arrancar). Nunca en producción.
CHAOS_TICKETING_FAIL=false
# true = si el comando issue-ticket no trae organizerId/staffUserIds, solo ADMIN valida (por defecto cualquier ORGANIZER)
STRICT_ORGANIZER_CHECK=false
VALIDATION_OPENS_BEFORE_MINUTES=120
VALIDATION_DEFAULT_DURATION_MINUTES=720
OUTBOX_RELAY_INTERVAL_MS=500
# Solo pruebas de integración: cola de comandos alternativa (la real la crea bandadau-infra)
# TICKETING_COMMANDS_QUEUE=ticketing-service.commands
DEFAULT_LOCALE=es
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=ticketing-service
