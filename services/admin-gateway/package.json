{
  "name": "admin-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Bandada U admin-gateway (S9): GraphQL BFF for the admin panel",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "schema:sync": "node scripts/schema-sync.mjs",
    "test": "jest --config jest.config.cjs",
    "test:int": "jest --config jest.int.config.cjs --runInBand",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "arch": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@bandada/auth-ts": "file:../../../bandadau-shared/packages/auth-ts",
    "@bandada/i18n": "file:../../../bandadau-shared/packages/i18n",
    "@graphql-tools/schema": "^10.1.4",
    "@graphql-tools/utils": "^10.11.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "amqplib": "^2.2.0",
    "dataloader": "^2.2.3",
    "express": "^5.1.0",
    "graphql": "^16.14.2",
    "graphql-ws": "^6.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@bandada/eslint-config": "file:../../../bandadau-shared/packages/eslint-config",
    "@bandada/tsconfig": "file:../../../bandadau-shared/packages/tsconfig",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/amqplib": "^0.10.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.0",
    "@types/ws": "^8.18.1",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9.39.5",
    "jest": "^30.0.0",
    "jose": "^6.2.12",
    "supertest": "^7.1.0",
    "typescript": "~5.9.3"
  }
