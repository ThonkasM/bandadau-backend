{
  "extends": "@bandada/tsconfig/node.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "types": [
      "node",
      "jest"
    ],
    "declaration": false,
    "incremental": false,
    "noUncheckedIndexedAccess": true,
    "strictPropertyInitialization": false,
    "isolatedModules": true
  },
  "include": [
    "src",
    "test"
  ]
}
