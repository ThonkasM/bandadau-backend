# admin-gateway — desarrollo local (valores ficticios; ver bandadau-infra/.env.example)
PORT=7010
NODE_ENV=development
JWKS_URL=http://localhost:7001/.well-known/jwks.json
JWT_ISSUER=http://api.bandada.localhost
# Audiencias aceptadas en el panel (coma). Los tokens del panel llevan aud=bandada-admin
JWT_AUDIENCE=bandada-admin
IDENTITY_URL=http://localhost:7001
SOCIAL_SERVICE_URL=http://localhost:7002
MEDIA_SERVICE_URL=http://localhost:7003
EVENTS_SERVICE_URL=http://localhost:7004
WALLET_SERVICE_URL=http://localhost:7005
TICKETING_SERVICE_URL=http://localhost:7006
NOTIFICATION_SERVICE_URL=http://localhost:7007
# Fase 2 (no usado en fase 1)
INSIGHTS_SERVICE_URL=http://localhost:7008
SERVICE_CLIENT_ID=admin-gateway
SERVICE_CLIENT_SECRET=dev-secret-admin-gateway
SERVICE_TOKEN_SCOPES=internal:read,internal:write
RABBITMQ_URL=amqp://bandada:bandada@localhost:5672
# Opcional: API de management de RabbitMQ para serviceHealth.queues (usuario monitor, solo lectura)
RABBITMQ_MANAGEMENT_URL=http://localhost:15672
RABBITMQ_MANAGEMENT_USER=monitor
RABBITMQ_MANAGEMENT_PASSWORD=monitor_dev
GRAPHQL_MAX_DEPTH=7
GRAPHQL_MAX_COMPLEXITY=1000
# false en producción (por defecto sigue a NODE_ENV)
GRAPHQL_INTROSPECTION=true
# Apollo Sandbox/landing page: solo dev
GRAPHQL_LANDING_PAGE=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4201,http://localhost:8081
HTTP_TIMEOUT_MS=3000
DEFAULT_LOCALE=es
# Id de la cola exclusiva de subscriptions (admin-gateway.subscriptions.<id>); aleatorio si se omite
# INSTANCE_ID=
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=admin-gateway
